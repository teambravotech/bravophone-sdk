{
  "name": "@bravophone/webphone",
  "version": "0.2.2",
  "description": "Webphone BRAVOPHONE embutível em qualquer página web. Renderiza uma janela flutuante arrastável com todas as funcionalidades do softphone.",
  "main": "./dist/bravophone.umd.js",
  "module": "./dist/bravophone.mjs",
  "types": "./types/index.d.ts",
  "unpkg": "./dist/bravophone.umd.js",
  "jsdelivr": "./dist/bravophone.umd.js",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/bravophone.mjs",
      "require": "./dist/bravophone.umd.js"
    }
  },
  "files": [
    "dist/*.js",
    "dist/*.mjs",
    "host",
    "types",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "sync": "node scripts/sync-from-extension.mjs && node scripts/audit-theme.mjs",
    "dev": "node scripts/dev-server.mjs",
    "build": "vite build",
    "build:host": "npm run sync && vite build --config vite.host.config.js",
    "test": "node scripts/smoke-shim.mjs && node scripts/smoke-geometry.mjs && node scripts/smoke-launcher.mjs && node scripts/smoke-package.mjs",
    "start": "node scripts/dev-server.mjs",
    "audit:theme": "node scripts/audit-theme.mjs",
    "prepublishOnly": "npm run build && npm test",
    "prepare:host": "node scripts/sync-from-extension.mjs --cdn",
    "purge": "node scripts/purge-cdn.mjs",
    "postpublish": "node scripts/purge-cdn.mjs"
  },
  "keywords": [
    "webphone",
    "softphone",
    "sip",
    "webrtc",
    "voip",
    "bravophone",
    "widget"
  ],
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "vite": "^5.4.0"
  },
  "author": "BravoTech",
  "homepage": "https://github.com/teambravotech/bravophone-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teambravotech/bravophone-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/teambravotech/bravophone-sdk/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "browser": "./dist/bravophone.umd.js"
}
